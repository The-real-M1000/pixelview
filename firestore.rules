rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is writing their own data
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    // Helper to get user document to verify admin role
    function isAdmin() {
      return isAuth() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true; // Public profiles are viewable by anyone
      allow create: if isAuth(); // Any authenticated user can create their profile
      allow update: if isOwner(userId) && 
                      (request.resource.data.role == resource.data.role || isAdmin()) // Users cannot change their own role
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Likes Collection
    match /likes/{likeId} {
      allow read: if true; // Public listings
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Favorites Collection
    match /favorites/{favoriteId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Playlists Collection
    match /playlists/{playlistId} {
      allow read: if true; // Public playlists can be read by anyone; filtering is done client-side
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isAdmin(); // Only admins can view reports
      allow create: if isAuth(); // Authenticated users can submit reports
      allow update, delete: if isAdmin(); // Only admins can moderate reports
    }

    // History Collection
    match /history/{historyId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Settings Collection
    match /settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth(); // Notifications can be generated by system events
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
